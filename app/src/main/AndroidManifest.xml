<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Storage ─────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ── Network ─────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Playback service ─────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        ACCESS_SURFACE: grants the app access to the car display's Surface object.
        Without this the SurfaceCallback fires but getSurface() returns null.
        This is the single most critical permission for video-on-Android-Auto.
    -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <!-- Declares a default attribution tag to avoid AppOps warnings during media playback -->
    <attribution
        android:tag="media_playback"
        android:label="@string/app_name" />

    <application
        android:name=".AutoPlayerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoPlayer"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Phone-side configuration UI (launcher entry point) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Auto Player">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Required so gearhead:projection can resolve this activity when
                 the user taps the settings icon for this app in Android Auto. -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
        </activity>

        <!--
            CarAppService — the Android Auto entry point.

            Category NAVIGATION is used (not MEDIA) because:
            1. Navigation apps receive full-screen SurfaceContainer access.
            2. MEDIA apps are sandboxed into the AA media browser UI.
            3. Fermata Auto and similar sideloaded video players use this trick.

            For a Play Store build you would need to switch to MEDIA and accept
            the standard media-browser restrictions.
        -->
        <service
            android:name=".service.AutoMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Tells the AA host which car features this app uses -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            Minimum Car App API level.
            Level 2 introduced SurfaceCallback / SurfaceContainer.
            Required for video surface access.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

    </application>
</manifest>
